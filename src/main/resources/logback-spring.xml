<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ─── Console appender ─────────────────────────────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ─── Axiom appender ────────────────────────────────────────────── -->
    <appender name="AXIOM" class="io.github.yhsj.axiom.AxiomAppender">
        <endpointUrl>https://api.axiom.co/v1/datasets/${AXIOM_DATASET:-socialapp-logs}/ingest</endpointUrl>
        <apiToken>${AXIOM_TOKEN}</apiToken>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
    </appender>

    <!-- ─── Local / dev profile: Console only ────────────────────────── -->
    <springProfile name="!prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- ─── Prod profile: Axiom + Console ────────────────────────────────

         CONSOLE cố ý có mặt ở đây, không phải thừa.

         Trước đây profile prod chỉ gắn AXIOM, nghĩa là Axiom là ĐƯỜNG LOG DUY NHẤT: một
         AXIOM_TOKEN sai, hết hạn, hoặc Axiom gặp sự cố là không còn dòng log nào ở bất cứ đâu —
         và đó chính là lúc cần log nhất. Tệ hơn, chế độ hỏng này im lặng: ứng dụng vẫn chạy bình
         thường, chỉ là `docker compose logs backend` trả về rỗng, nên người trực rất dễ kết luận
         nhầm là container chưa khởi động.

         Chi phí gần như bằng không: stdout của container đằng nào cũng được Docker thu, và
         `docker compose logs` là thứ đầu tiên người ta gõ khi SSH vào máy chủ. -->
    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="AXIOM"/>
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="com.socialapp" level="INFO" additivity="false">
            <appender-ref ref="AXIOM"/>
            <appender-ref ref="CONSOLE"/>
        </logger>
    </springProfile>

</configuration>
